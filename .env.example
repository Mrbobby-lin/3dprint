# 复制为 .env 后修改。生产环境务必 chmod 600 .env
# 生成密钥： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3000

# 监听地址。默认 127.0.0.1，只让本机 Nginx 能连上。
# 生产环境不要改成 0.0.0.0 —— 那会让 Node 直接暴露在公网，
# 请求可以绕过 Nginx，连带绕过它的限流和 /storage/ 保险丝。
HOST=127.0.0.1

# 数据库文件路径（相对项目根目录或绝对路径）
DB_FILE=data/app.db

# 上传文件存储目录
STORAGE_DIR=storage

# 会话 cookie 签名密钥 —— 必须改！改掉后所有已登录会话立即失效
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS

# cookie 的 Secure 标志。留空则跟随 NODE_ENV（生产=true），一般不用设。
# 只有一种情况要显式设为 false：服务器还没有域名和证书，只能先用 IP 走 HTTP。
# 设成 false 后浏览器才会在 HTTP 连接上回传 cookie；否则登录会表现为
# "接口返回成功、下一个请求却 401"。这是明文传输，仅限临时使用。
# COOKIE_SECURE=false

# 管理员注册开关。首次注册成功后改成 false 并重启，注册接口将返回 404
ALLOW_ADMIN_REGISTRATION=true

# 反向代理信任层数：本机 Nginx 反代保持 loopback，不要改成 true
TRUST_PROXY=loopback

# 单文件上传上限（字节），需与 Nginx client_max_body_size 保持一致
MAX_UPLOAD_BYTES=20971520

# 单订单附件总量上限（字节）
MAX_ORDER_ATTACHMENT_BYTES=209715200

# 存储磁盘水位告警线（百分比），超过后拒绝上传
STORAGE_WATERMARK_PERCENT=90
